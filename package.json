{
  "name": "knowledge-vault-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "knowledge-vault": "dist/cli.js"
  },
  "exports": {
